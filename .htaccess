ServerSignature Off
Options +FollowSymLinks -MultiViews
# EXTRA SECURITY HEADERS IN COOKIES
<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "https://www.orgonatural.com/"
    Header set Content-Security-Policy:    "default-src 'self' https://jsonplaceholder.typicode.com https://widget.getbutton.io https://*.tawk.to  https://www.youtube.com https://googleads.g.doubleclick.net https://checkout.razorpay.com https://api.razorpay.com/; frame-ancestors 'none'; connect-src 'self' https://onesignal.com https://*.tawk.to https://*.jsdelivr.net https://*.tawk.to wss://*.tawk.to blob: ; script-src 'self' blob: data: 'unsafe-inline' 'unsafe-eval' https://cdn.onesignal.com https://onesignal.com https://*.getbutton.io https://*.tawk.to https://www.googletagmanager.com https://www.google-analytics.com https://*.jsdelivr.net https://checkout.razorpay.com; object-src 'none'; style-src 'self'  https://*.googleapis.com 'unsafe-inline' https://*.jsdelivr.net https://onesignal.com; img-src 'self' 'unsafe-inline' 'unsafe-eval' blob: data: https://*.tawk.to https://*.jsdelivr.net https://www.google-analytics.com https://www.surun.in; font-src 'self' https://*.gstatic.com  https://*.tawk.to/ data:;"

    <FilesMatch "\.(css|png|js)$">
    Header set X-Content-Type-Options nosniff
    </FilesMatch>
</IfModule>

<IfModule mod_headers.c>
    Header set Access-Control-Allow-Origin "*"
</IfModule>

# URL Canonicalization (adding www. prefix to URL)
   <IfModule mod_rewrite.c>
   RewriteCond %{HTTP_HOST} !^www\..+$ [NC]
   RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]
 </IfModule>

# BEGIN cPanel-generated php ini directives, do not edit
